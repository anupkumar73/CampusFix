PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/campusfix
JWT_SECRET=change_this_for_production
CLIENT_ORIGIN=http://localhost:5000

# Optional AI provider. If empty, CampusFix uses its local rule-based AI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Demo mode keeps the app usable even if MongoDB is unavailable.
DEMO_MODE=true
